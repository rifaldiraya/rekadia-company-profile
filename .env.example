# Copy to .env.development / .env.staging / .env.production (scripts/prebuild-*.cjs copy them to .env.local)

# --- Public company-profile site ---
# Base URL of the ASP.NET Core API, without a trailing slash (Swagger: {URL}/swagger/index.html)
NEXT_PUBLIC_API_BASE_URL=https://dev.rkdweb.apps-dev.rekadia.co.id
# "true"  -> always use the in-browser mock (no backend needed)
# "false" -> always call the real API
# unset   -> call the real API, fall back to the mock in development when it is unreachable
NEXT_PUBLIC_USE_API_MOCK=
# Canonical site URL used for metadata / Open Graph
NEXT_PUBLIC_SITE_URL=https://www.rekadia.co.id

# --- Admin template (dashboard) ---
# Same API as above; used by the template's axios client (account, users, roles)
NEXT_PUBLIC_BASE_URL=https://dev.rkdweb.apps-dev.rekadia.co.id
NEXT_PUBLIC_MUI_LICENSE=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
JWT_SECRET=
